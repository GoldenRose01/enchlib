# Entita vanilla aggiunte dopo il riferimento originale (IDs del registry Minecraft).
# Ghastling e Happy Ghast sono fasi di crescita dello stesso tipo di entita.
minecraft:creaking=fungi,cubic
minecraft:camel_husk=animals,undead
minecraft:nautilus=animals,water
minecraft:zombie_nautilus=undead,water
minecraft:parched=undead,hell
minecraft:happy_ghast=magik,hell,cubic,flying
minecraft:sulfur_cube=cubic,magik
# Entita vanilla registrata ma non normalmente generata nel gioco.
minecraft:giant=undead,cubic


# =========================================================================
# Note per sviluppatori
# =========================================================================
# Queste categorie vengono utilizzate dal sistema di incantesimi per:
# 1. Calcolare moltiplicatori di danno specifici (es. Smite vs undead)
# 2. Determinare efficacia di protezioni (es. protezione vs nether)
# 3. Applicare effetti speciali basati su tipo di creatura
# 4. Bilanciare incantesimi custom
