# =============================================================================
# MobCategory.config - Categorizzazione Mob
# =============================================================================
# Formato: mobId=category1,category2,category3
#
# Categorizza mob vanilla e modded per permettere agli incantesimi di avere
# effetti specifici contro certe categorie di mob.
# Usa gli ID completi del registry per i mob vanilla e modded:
# minecraft:zombie=undead,hostile
# othermod:crystal_beast=magical,boss
# I vecchi nomi non qualificati vengono ancora interpretati come ID minecraft.
#
# Categorie effettivamente usate dai dati qui sotto:
# - animals, arthropods, cubic, flying, fungi, hell, magik,
#   rebel, undead, void, water
# Le categorie degli incantesimi possono anche usare `all` per indicare
# un bersaglio senza restrizioni; non serve assegnare `all` ai singoli mob.
#
# Linee che iniziano con # sono commenti e vengono ignorate
# =============================================================================

# EnchLib - MobCategories (namespace:mob_id=cat1,cat2,...)

Allay=magik,flying
Armadillo=animals,cubic
Axolotl=animals,water,arthropods
Bat=animals,flying
Bee=flying
Blaze=magik,hell,flying
Bogged=undead,fungi
Breeze=magik,flying
Camel=animals
Cat=animals
Cave spider=arthropods
Chicken=animals
Cod=water
Copper Golem=magik,cubic
Cow=animals
